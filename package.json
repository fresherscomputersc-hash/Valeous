{
  "name": "curio-discovery-commerce-mvp",
  "version": "0.1.0",
  "private": true,
  "description": "Three-sided Discovery-to-Commerce Platform MVP (Customers, Creators, Businesses, Admins)",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:backup": "bash scripts/backup-db.sh",
    "db:restore": "bash scripts/restore-db.sh",
    "worker:dev": "tsx watch src/workers/index.ts",
    "worker:start": "tsx src/workers/index.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@libsql/client": "^0.14.0",
    "@node-rs/argon2": "^2.0.2",
    "better-sqlite3": "^11.10.0",
    "bullmq": "^6.7.10",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.4",
    "ioredis": "^6.1.0",
    "jose": "^6.0.10",
    "lucide-react": "^0.479.0",
    "next": "15.5.29",
    "postgres": "^4.1.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@testcontainers/postgresql": "^12.2.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.21.0",
    "eslint-config-next": "15.5.29",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.17",
    "testcontainers": "^12.2.2",
    "tsx": "^4.23.15",
    "typescript": "^5.8.2",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "postcss": "^8.5.32"
  }
}
