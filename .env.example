# ============================================================================
# VALUEOUS environment template
# Copy to `.env` (or inject as container/host env vars) and fill real values.
# NEVER commit the real `.env`.
# ============================================================================

NODE_ENV="development"

# ---- Public (inlined into the client bundle at BUILD time) ------------------
# Changing these requires a rebuild, not just a restart.
NEXT_PUBLIC_APP_NAME="VALUEOUS"
NEXT_PUBLIC_PILOT_LABEL="Customers x Creators x Businesses"
NEXT_PUBLIC_DEFAULT_TIMEZONE="Asia/Kolkata"
NEXT_PUBLIC_DEMO_MODE="true"

# ---- URLs ------------------------------------------------------------------
APP_URL="http://localhost:3000"
APP_BASE_URL="http://localhost:3000"
ALLOWED_ORIGINS="http://localhost:3000"

# ---- Feature Flags ---------------------------------------------------------
PRODUCT_COMMERCE_ENABLED="false"

# ---- Database (PostgreSQL 17 + PostGIS) ------------------------------------
POSTGRES_USER="valueous"
POSTGRES_PASSWORD="valueous_dev_password"
POSTGRES_DB="valueous"
DATABASE_URL="postgresql://valueous:valueous_dev_password@localhost:5432/valueous"

# ---- Redis 7 (Cache, Locks, BullMQ) ----------------------------------------
REDIS_URL="redis://localhost:6379"

# ---- Legacy SQLite (pre-VLS-103 compatibility; do not use for new code) ----
DATABASE_FILE="file:./storage/d2c_mvp.sqlite"

# ---- Secrets (generate with: openssl rand -hex 32) -------------------------
JWT_SECRET="replace-with-64-char-cryptographically-random-jwt-secret-for-dev"
SESSION_SECRET="replace-with-64-char-cryptographically-random-session-secret"
CLAIM_CODE_SECRET="replace-with-64-char-cryptographically-random-hmac-pepper"
WEBHOOK_HMAC_SECRET="replace-with-64-char-cryptographically-random-webhook-secret"
CRON_SECRET="dev-cron-housekeeping-secret-2026"

# ---- Payments --------------------------------------------------------------
PAYMENT_PROVIDER="mock"

# ---- Business rules --------------------------------------------------------
PLATFORM_FEE_PERCENT="10"
MIN_PAYOUT_RUPEES="200"

# ---- Cookies / security headers -------------------------------------------
COOKIE_PARTITIONED_PREVIEW="false"
CSP_FRAME_ANCESTORS="'none'"

# ---- Demo seeding ----------------------------------------------------------
ALLOW_DEV_SEED="true"

# ---- Email -----------------------------------------------------------------
EMAIL_PROVIDER="local"
EMAIL_FROM="no-reply@valueous.local"
EMAIL_WEBHOOK_URL=""
EMAIL_API_KEY=""

# ---- Media storage ---------------------------------------------------------
STORAGE_PROVIDER="local"
UPLOAD_MAX_BYTES="5242880"
S3_ENDPOINT=""
S3_BUCKET=""
S3_REGION="ap-south-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# ---- Observability ---------------------------------------------------------
ERROR_MONITORING_DSN=""
LOG_LEVEL="info"
