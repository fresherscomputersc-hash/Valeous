# ============================================================================
# VALUEOUS production environment template
# Copy to `.env` (or inject as container/host env vars) and fill real values.
# NEVER commit the real `.env`.
# ============================================================================

NODE_ENV="production"

# ---- Public (inlined into the client bundle at BUILD time) ------------------
# Changing these requires a rebuild, not just a restart.
NEXT_PUBLIC_APP_NAME="VALUEOUS"
NEXT_PUBLIC_PILOT_LABEL="Customers x Creators x Businesses"
NEXT_PUBLIC_DEFAULT_TIMEZONE="Asia/Kolkata"
NEXT_PUBLIC_DEMO_MODE="true"

# ---- URLs ------------------------------------------------------------------
# Must match the public https origin exactly (no trailing slash).
APP_BASE_URL="https://your-domain.example"
ALLOWED_ORIGINS="https://your-domain.example"

# ---- Database (SQLite via libSQL) ------------------------------------------
# Use a path inside the persistent volume. The Docker image defaults to
# /app/storage/d2c_mvp.sqlite and mounts /app/storage as a volume.
DATABASE_FILE="file:/app/storage/d2c_mvp.sqlite"

# ---- Secrets (generate with: openssl rand -hex 32) -------------------------
SESSION_SECRET="replace-with-64-char-cryptographically-random-session-secret"
CLAIM_CODE_SECRET="replace-with-64-char-cryptographically-random-hmac-pepper"
CRON_SECRET="replace-with-random-cron-secret"

# ---- Business rules --------------------------------------------------------
PLATFORM_FEE_PERCENT="10"
MIN_PAYOUT_RUPEES="200"

# ---- Cookies / security headers -------------------------------------------
# Set to "false" on a normal https domain. "true" only for partitioned iframes.
COOKIE_PARTITIONED_PREVIEW="false"
CSP_FRAME_ANCESTORS="'none'"

# ---- Demo seeding ----------------------------------------------------------
# Keep "false" in production. To seed demo data on a fresh live DB, run the
# seed script once with NODE_ENV=development and ALLOW_DEV_SEED=true.
ALLOW_DEV_SEED="false"

# ---- Email -----------------------------------------------------------------
# "local" writes to storage/dev-outbox.json (fine for a demo, no real sending).
# "webhook" posts to an HTTP email API (e.g. Resend).
EMAIL_PROVIDER="local"
EMAIL_FROM="no-reply@your-domain.example"
EMAIL_WEBHOOK_URL=""
EMAIL_API_KEY=""

# ---- Media storage ---------------------------------------------------------
# "local" stores uploads on disk under /app/storage/uploads (works with the
# Docker volume). "s3" is a stub that only rewrites URLs - do NOT use it.
STORAGE_PROVIDER="local"
UPLOAD_MAX_BYTES="5242880"
S3_ENDPOINT=""
S3_BUCKET=""
S3_REGION="ap-south-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# ---- Observability ---------------------------------------------------------
ERROR_MONITORING_DSN=""
LOG_LEVEL="info"
