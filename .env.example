# ============================================================================
# VALUEOUS environment template (VLS-TBP-2026-001)
# Copy to `.env` for local development (or inject via secrets manager in prod).
# NEVER commit the real `.env` or real secrets.
# ============================================================================

NODE_ENV="development"

# ---- Public (inlined into the client bundle at BUILD time) ------------------
# Changing these requires a rebuild, not just a restart.
NEXT_PUBLIC_APP_NAME="VALUEOUS"
NEXT_PUBLIC_PILOT_LABEL="Customers x Creators x Businesses"
NEXT_PUBLIC_DEFAULT_TIMEZONE="Asia/Kolkata"
NEXT_PUBLIC_DEMO_MODE="true"

# ---- URLs ------------------------------------------------------------------
# Must match the public origin without a trailing slash.
APP_URL="http://localhost:3000"
APP_BASE_URL="http://localhost:3000"
ALLOWED_ORIGINS="http://localhost:3000"

# ---- Database & Cache (PostgreSQL 17 + PostGIS & Redis 7) ------------------
DATABASE_URL="postgresql://valueous:valueous_dev_password@localhost:5432/valueous"
REDIS_URL="redis://localhost:6379"

# Legacy SQLite path (retained until VLS-103 completes PG17 Drizzle migration)
DATABASE_FILE="file:./storage/d2c_mvp.sqlite"

# ---- Secrets (generate with: openssl rand -hex 32) -------------------------
JWT_SECRET="replace-with-64-char-cryptographically-random-jwt-secret-dev-only"
WEBHOOK_HMAC_SECRET="replace-with-64-char-cryptographically-random-webhook-hmac-secret"
SESSION_SECRET="replace-with-64-char-cryptographically-random-session-secret"
CLAIM_CODE_SECRET="replace-with-64-char-cryptographically-random-hmac-pepper"
CRON_SECRET="replace-with-random-cron-secret-at-least-32-chars"

# ---- Payments & Feature Flags ----------------------------------------------
PAYMENT_PROVIDER="mock"
# Product commerce stays disabled at launch per Blueprint Ch. 3 & 12 (requires Owner approval)
PRODUCT_COMMERCE_ENABLED="false"

# ---- Business rules --------------------------------------------------------
PLATFORM_FEE_PERCENT="10"
MIN_PAYOUT_RUPEES="200"

# ---- Cookies / security headers -------------------------------------------
# Set to "false" on a normal https domain. "true" only for partitioned iframes.
COOKIE_PARTITIONED_PREVIEW="false"
CSP_FRAME_ANCESTORS="'none'"

# ---- Demo seeding ----------------------------------------------------------
# Keep "false" in production. Set "true" locally for `npm run db:seed`.
ALLOW_DEV_SEED="true"

# ---- Email -----------------------------------------------------------------
# "local" writes to storage/dev-outbox.json (fine for local dev, no real sending).
# "webhook" posts to an HTTP email API (e.g. Resend).
EMAIL_PROVIDER="local"
EMAIL_FROM="no-reply@valueous.local"
EMAIL_WEBHOOK_URL=""
EMAIL_API_KEY=""

# ---- Media storage ---------------------------------------------------------
# "local" stores uploads on disk under storage/uploads.
STORAGE_PROVIDER="local"
UPLOAD_MAX_BYTES="5242880"
S3_ENDPOINT=""
S3_BUCKET=""
S3_REGION="ap-south-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# ---- Observability ---------------------------------------------------------
ERROR_MONITORING_DSN=""
LOG_LEVEL="info"
